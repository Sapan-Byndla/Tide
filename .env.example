# =============================================================================
# TIDE — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` and adjust values:  cp .env.example .env
#
# NEVER commit a real `.env` file or any secret. `.env` is git-ignored, and
# secret values are never printed by the app. In local development TIDE runs
# entirely without real Supabase or R2 credentials.
# =============================================================================

# ---- Application ----
TIDE_ENV=local                     # local | test | staging | production
TIDE_DEBUG=true
TIDE_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
TIDE_LOG_JSON=false                # true = JSON logs (prod), false = console (dev)
TIDE_API_HOST=0.0.0.0
TIDE_API_PORT=8000

# ---- PostgreSQL (system of record) ----
# DATABASE_URL (unprefixed) takes precedence. If unset, a URL is composed from
# the discrete POSTGRES_* fields below. Local default matches docker-compose.
DATABASE_URL=postgresql+psycopg://tide:tide_local_password@localhost:5432/tide
TIDE_POSTGRES_HOST=localhost
TIDE_POSTGRES_PORT=5432
TIDE_POSTGRES_USER=tide
TIDE_POSTGRES_PASSWORD=tide_local_password
TIDE_POSTGRES_DB=tide

# ---- Supabase (managed Postgres in staging/prod; SECRETS — leave empty locally) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (raw / large payloads) ----
# Backend selects the adapter. Local dev/tests use `memory` (no credentials).
TIDE_STORAGE_BACKEND=memory        # memory | filesystem | r2
TIDE_FILESYSTEM_STORAGE_PATH=.tide/objectstore

# ---- Cloudflare R2 (S3-compatible; SECRETS — only for staging/prod) ----
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto

# ---- Redis (optional future queue/cache) ----
TIDE_REDIS_URL=redis://localhost:6379/0

# ---- Embedding provider (model + DIMENSION chosen in a LATER phase) ----
# Do not set a dimension here; the embeddings column is intentionally dimensionless.
TIDE_EMBEDDING_PROVIDER=noop       # noop | local | openai | cohere | ...
TIDE_EMBEDDING_MODEL=none

# ---- LLM provider (replaceable; NO paid-provider lock-in) ----
TIDE_LLM_PROVIDER=noop             # noop | local | anthropic | openai | ...
TIDE_LLM_MODEL=none
TIDE_LLM_API_KEY=

# ---- Seed configuration / collection ----
TIDE_SEED_LIST_PATH=seed_list.yaml
TIDE_HISTORICAL_LOOKBACK_DAYS=60   # ~2 months before system start date
TIDE_SCRAPER_RATE_LIMIT_PER_MIN=60
TIDE_SCRAPER_CHECKPOINT_DIR=.tide/checkpoints

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
